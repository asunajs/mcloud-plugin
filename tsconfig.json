{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // 源码里 import 相对路径要带 .ts 后缀：Node 的类型剥离（node --test test/*.ts）
    // 不做模块解析，写 './bytes' 会直接报模块找不到。配合 noEmit 用。
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,

    // 空数组 = **不许用任何 @types**。
    //
    // 这不是洁癖：插件最终跑在 QuickJS 沙箱里，那里没有 Node（没有 process / Buffer /
    // fs / crypto / setTimeout）。如果 tsconfig 里带了 @types/node，我在这份源码里
    // 顺手写个 `Buffer.from(...)` 也能通过类型检查，然后在面板里运行时报 undefined。
    // 类型检查在这里的作用是**当围栏**，不是补全提示。
    "types": [],

    // `panel:host` 由面板引擎注入，不是 npm 包；类型在 src/types/panel-host.d.ts
    // （`declare module`，不需要 paths —— 业务层也**不准**直接 import 它，见 R1）
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/standalone/**"]
}
