{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // 源码里 import 相对路径要带 .ts 后缀：Node 的类型剥离（node --test test/*.ts）
    // 不做模块解析，写 './bytes' 会直接报模块找不到。配合 noEmit 用。
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,

    // Node 类型**开着**：宿主层（src/host/fs）要写 `node:fs`（面板引擎也提供它），
    // CLI 也是 Node。领域层的围栏不再是"类型系统不给"，而是**可执行的门禁**：
    // `scripts/check-layers.mjs` 的 R3 —— src/mcloud 里出现 node:* / Buffer / process /
    // setTimeout 直接判红。写成门禁比写成 tsconfig 更明确，也能给准确的报错。
    "types": ["node"],

    // `panel:host` 由面板引擎注入，不是 npm 包。类型用共享契约 types/panel-host.d.ts
    // （真源 panel-llrt/tools/plugin-shared/，sync-types 同步）。
    // ⚠ 业务层**不准**直接 import 它（R1：只有 src/host/panel/impl.ts 一处碰宿主）。
    "baseUrl": ".",
    "paths": { "panel:host": ["./types/panel-host.d.ts"] },
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/standalone/**"]
}
