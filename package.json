{
  "name": "mcloud-plugin",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "description": "mcloud 的 JS/TS 重写版 —— 可作为面板插件，也可独立运行（替代 mcloud-sign）",
  "bin": {
    "mcloud-sign": "./dist/standalone/mcloud-sign.mjs"
  },
  "exports": {
    "./standalone": "./dist/standalone/mcloud-sign.mjs",
    "./daily": "./dist/standalone/daily.mjs",
    "./exchange": "./dist/standalone/exchange.mjs",
    "./redflower": "./dist/standalone/redflower.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "check-build": "node scripts/check-build.mjs",
    "check-build:standalone": "node scripts/check-build-standalone.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:standalone": "tsc -p tsconfig.standalone.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "all": "npm run gen && npm run typecheck && npm test && npm run check-build && npm run check-split",
    "gen": "node scripts/gen-constants.mjs",
    "check-split": "python3 scripts/split_check.py",
    "e2e": "./scripts/e2e-mock.sh \"${PANEL_BIN:-../rust-plugin-panel/target/release/plugin-panel}\"",
    "shots": "node scripts/shots.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "fast-png": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ws": "^8.22.0"
  }
}
