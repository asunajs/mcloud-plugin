{
  "name": "mcloud-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "mcloud 的 JS/TS 重写版 —— 作为 rust-plugin-panel 的插件运行",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check-build": "node scripts/check-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "all": "npm run gen && npm run typecheck && npm test && npm run check-build",
    "gen": "node scripts/gen-constants.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fast-png": "^8.0.0"
  }
}
