{
  "name": "mcloud-plugin",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "mcloud 的 JS/TS 重写版 —— panel-llrt 的四个插件 + 一个 Node CLI（共用一份核心）",
  "bin": {
    "mcloud": "./dist/standalone/mcloud-sign.mjs",
    "mcloud-sign": "./dist/standalone/mcloud-sign.mjs"
  },
  "exports": {
    "./standalone": "./dist/standalone/mcloud-sign.mjs",
    "./daily": "./dist/standalone/daily.mjs",
    "./exchange": "./dist/standalone/exchange.mjs",
    "./redflower": "./dist/standalone/redflower.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs",
    "build:dir": "node scripts/build-dir.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "check-build": "node scripts/check-build.mjs",
    "check-build:standalone": "node scripts/check-build-standalone.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && npm run typecheck:webui",
    "typecheck:standalone": "tsc -p tsconfig.standalone.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "all": "npm run gen && npm run check:types && npm run typecheck && npm run build && npm test && npm run check-build && npm run check-layers",
    "check-layers": "node scripts/check-layers.mjs",
    "gen": "node scripts/gen-constants.mjs",
    "e2e": "./scripts/e2e-mock.sh \"${PANEL_BIN:-../../panel-llrt/target/release/panel}\"",
    "shots": "node scripts/shots.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:panel04": "node scripts/pack.mjs",
    "deploy:panel": "bash scripts/deploy-panel.sh",
    "install:panel-binary": "bash scripts/install-panel-binary.sh",
    "check:types": "node scripts/sync-types.mjs --check",
    "typecheck:webui": "tsc -p tsconfig.webui.json --noEmit",
    "check": "npm run check:types && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "fast-png": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ws": "^8.22.0"
  }
}
